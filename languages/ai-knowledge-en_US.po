#: admin/class-admin.php:255
msgid "AI Knowledge & Visibility"
msgstr "AI Knowledge & Visibility"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://22mw.online/"
msgstr "https://22mw.online/"

#. Description of the plugin
msgid "Genera documentos de base de conocimiento (.md + posts sgkb-docs de Support Genix) a partir de productos WooCommerce u otros CPTs, con cola, límite diario, WPML y publicación pública GEO vía llms.txt."
msgstr "Generates knowledge base documents (.md + Support Genix sgkb-docs posts) from WooCommerce products or other CPTs, with a queue, daily limit, WPML, and public GEO publishing via llms.txt."

#. Author of the plugin
msgid "22MW"
msgstr "22MW"

