msgstr "Taxonomiak / terminoak"

#: admin/views/tab-contenido.php:95
msgid "Nada marcado = todos los términos. Marcado = solo entran posts con ese término."
msgstr "Ezer markatu gabe = termino guztiak. Markatuta = termino hori duten argitalpenak bakarrik sartzen dira."

